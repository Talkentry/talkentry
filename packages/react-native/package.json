{
  "name": "@talkentry/react-native",
  "version": "0.0.1",
  "description": "Customizable, backend-agnostic chat SDK for React Native",
  "license": "MIT",
  "author": "Maksim Kapustin",
  "contributors": [
    {
      "name": "Aleksandr Bulaev"
    }
  ],
  "homepage": "https://github.com/talkentry/talkentry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talkentry/talkentry.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/talkentry/talkentry/issues"
  },
  "keywords": [
    "react-native",
    "react-native-chat",
    "react-native-messaging",
    "chat",
    "chat-sdk",
    "chat-ui",
    "chat-component",
    "messaging",
    "messenger",
    "message-list",
    "conversation",
    "in-app-chat",
    "realtime",
    "realtime-chat",
    "support-chat",
    "talkentry"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "talkentry-source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "bob clean",
    "prepack": "bob build",
    "test": "jest --config jest.config.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@talkentry/core": "^0.0.1"
  },
  "peerDependencies": {
    "@shopify/flash-list": "^2.0.0",
    "react": "19.3.x",
    "react-native": "0.88.x",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.10.1"
  },
  "devDependencies": {
    "@shopify/flash-list": "^2.3.3",
    "react": "19.3.1",
    "react-native": "0.88.0",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.10.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  }
}
